# Bu dosyayı kopyalayın: cp env.example .env  (Windows: copy env.example .env)

DATABASE_URL="mysql://root:password@localhost:3306/profusta"
JWT_SECRET="degistir-guclu-bir-secret-en-az-32-karakter"
JWT_EXPIRES_IN="7d"
REDIS_URL="redis://localhost:6379"
# Yerelde İyzico için localhost kullanmayın — ngrok HTTPS tünel gerekir (aşağıya bakın)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ProfUSTA"

# İlk admin (db:seed)
ADMIN_EMAIL="admin@profusta.com"
ADMIN_PASSWORD="Admin1234!"
ADMIN_NAME="ProfUSTA Admin"

# Google OAuth — Admin: /admin/google-giris (Client ID / Secret)

# İyzico (Checkout Form) — Admin panelinden yönetilir: /admin/iyzico-ayarlari
# Yerel test için callback localhost OLAMAZ. Seçenekler:
# A) Ubuntu VPS / staging (önerilen): gerçek domain + HTTPS
#    NEXT_PUBLIC_APP_URL="https://staging.profusta.com"
#    Admin → İyzico Ayarları → callback URL staging domain
# B) Tünel (sadece laptop’tan test): ngrok, cloudflared, localtunnel
#    NEXT_PUBLIC_APP_URL="https://SIZIN-ID.ngrok-free.app"
#    Admin → İyzico Ayarları → callback URL ngrok adresi

# Cron (48 saat otomatik sipariş onayı)
CRON_SECRET="degistir-guclu-cron-secret"

# Harita: Leaflet + OpenStreetMap (ek API anahtarı gerekmez)

# CDN (görsel yükleme — talep, ilan, mesaj)
CDN_BASE_URL="https://cdn.example.com"
CDN_UPLOAD_URL="https://cdn.example.com/upload.php"
CDN_UPLOAD_TOKEN=""

# E-posta (opsiyonel — boşsa konsola log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@profusta.com"
