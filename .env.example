# Veritabanı (MySQL / MariaDB)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/profusta"

# JWT oturum
JWT_SECRET="degistir-guclu-bir-secret-en-az-32-karakter"
JWT_EXPIRES_IN="7d"

# Redis (opsiyonel — yoksa bellek içi cache/rate-limit kullanılır)
REDIS_URL="redis://localhost:6379"

# Uygulama
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ProfUSTA"
# Logo önbelleğini kırmak için dosya değişince artırın (ör. 2, 3)
NEXT_PUBLIC_LOGO_VERSION="1"

# Google OAuth — Admin panelinden yönetilir (/admin/google-giris)

# Ödeme — İyzico ayarları Admin panelinden yönetilir (/admin/iyzico-ayarlari)

# Dosya yükleme — harici CDN (talep fotoğrafı, ilan, avatar, mesaj görseli)
CDN_UPLOAD_URL=""
CDN_UPLOAD_TOKEN=""
CDN_BASE_URL=""

# E-posta (opsiyonel — yoksa konsola log yazar)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@profusta.com"

# Cron — otomatik sipariş tamamlama (/api/cron/auto-complete-orders)
CRON_SECRET="degistir-guclu-cron-secret"
